## Get direction numbers for a specific dimension
static func get_direction_numbers(dimension: int) -> Array:
	if dimension < 0 or dimension >= DIRECTION_NUMBERS.size():
		return []
	return DIRECTION_NUMBERS[dimension]

## Get maximum supported dimension
static func get_max_dimension() -> int:
	return 1024

## Check if direction numbers are available for dimension
static func has_dimension(dimension: int) -> bool:
	if dimension < 2 or dimension >= DIRECTION_NUMBERS.size():
		return false
	return not DIRECTION_NUMBERS[dimension].is_empty()
